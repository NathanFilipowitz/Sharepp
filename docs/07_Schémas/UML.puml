@startuml Share++

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Point d'entrée" {
    class main {
        +main(page: ft.Page)
        +is_admin(): bool
        -- détecte --nogui --
        -- élève les droits admin --
    }
}

package "Application Flet" {
    class app_controller {
        -model: Model
        -view: View
        +log(message, level)
        +start_server(e)
        +stop_server(e)
        +pick_folder(e)
        +toggle_hotspot(e)
        +open_port_dialog(e)
        +generate_qr_data_url(url): str
        -_detect_all_ips(): tuple
        -_show_connection_info(local_ip, overlay_ips)
    }

    class View {
        -page: ft.Page
        -controller: app_controller
        +add_log_entry(message, level)
        +update_server_controller_status(running)
        +show_qr_code(qr_data, url)
        +show_dual_qr(...)
        +show_hotspot_qr_codes(...)
        +show_controls()
        +update_hotspot_button(running)
    }
}

package "Mode CLI" {
    class cli {
        +run_cli()
        +parse_args(): Namespace
        +log(message, level)
        +print_qr(url)
        -_run(args)
    }
}

package "Modèle" {
    class Model {
        -data: dict
        -config_path: Path
        -log_path: Path
        -file_logger: Logger
        +load_settings()
        +save_settings()
        +log_to_file(message, level)
        +set_path(path)
        +set_port(port)
        +set_password(pwd)
        +check_password(input_pwd): bool
        +set_hotspot_credentials(ssid, pwd)
        +toggle_protection()
        +toggle_qr()
    }
}

package "Contrôleurs partagés" {
    class server_controller {
        +build_app(shared_path, password_hash, log_fn): Application
        +make_handlers(shared_path, log_fn): tuple
        +make_auth_middleware(password_hash): middleware
        +parse_user_agent(ua): str
    }

    class network_controller {
        +get_local_ip(): str
        +get_tailscale_ip(port): str
        -{static}_detect_tailscale_ip(): str
        -{static}_is_reachable(ip, port): bool
    }

    class hotspot_controller {
        +get_hotspot_status(): dict
        +setup_and_start(ssid, password): tuple
        +stop_hotspot(): tuple
        +execute_command(command): tuple
    }
}

package "Vue Web" {
    class download_view {
        +generate_html(files): str
    }
}

' Relations
main --> app_controller : instancie (mode GUI)
main --> cli : délègue (--nogui)

app_controller --> Model : lit/écrit
app_controller --> View : met à jour
app_controller --> server_controller : build_app()
app_controller --> network_controller : get_local_ip(), get_tailscale_ip()
app_controller --> hotspot_controller : toggle_hotspot

cli --> server_controller : build_app()
cli --> network_controller : get_local_ip()

server_controller --> download_view : generate_html()

View --> app_controller : événements utilisateur

@enduml